Q: WAP to check Vowels
import java.util.*;

public class WSCUBE {
    public static void main(String[] args) {
        char ch = 'a'; // character to check

        // Check both lowercase and 
        // uppercase vowels
        if (ch == 'a' || ch == 'e' || 
            ch == 'i' || ch == 'o' || 
            ch == 'u' ||
            ch == 'A' || ch == 'E' || 
            ch == 'I' || ch == 'O' || 
            ch == 'U') {
            System.out.println("Vowel");
        } else {
            System.out.println("Consonant");
        }
    }
}
