Q: Program to implement Opearations of ArrayList:

package arraylistoperations;

import java.util.ArrayList;
import java.util.Collection;
import java.util.*;

public class ArrayListOperations {

    public static void main(String[] args) {
        ArrayList<Integer> list = new ArrayList<>();
       
        //Add Operation
        list.add(0);
        list.add(2);
        list.add(3);
        list.add(4);
        list.add(6);
        System.out.println("After adding elements in list");
        System.out.println(list);
        
        //get Operation
        int element = list.get(2);
        System.out.println("After applying get operation");
        System.out.println(element);
        
        //add element in beetween
        list.add(1, 1);
        System.out.println("After adding element in between 0 and 2");
        System.out.println(list);
        
        //set element
        list.set(0, 5);
        System.out.println("After set or replace the element");
        System.out.println(list);
        
        //Delete element
        list.remove(3);
        System.out.println("After removing an element");
        System.out.println(list);
        
        //Size
        int size = list.size();
        System.out.println("The size of list is= " + size);
        
        //loops
        System.out.println("After iterating elements through loop");
        for(int i=0; i<list.size(); i++){
            System.out.println(list.get(i));
        }
        System.out.println();
        
        //sorting
        System.out.println("After Sorting the list");
        Collections.sort(list);
        System.out.println(list);
    
    
    }
}

