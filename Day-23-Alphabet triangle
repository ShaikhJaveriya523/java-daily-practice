Q:WAP to print alphabet triangle : 
package alphabettriangle;


public class AlphabetTriangle {

    public static void main(String[] args) {
        int no=7;
        char ch='A';
        for(int i=1; i<=no; i++){
            for(int j=1;j<=i;j++){
                System.out.print(ch +" ");
                ch++;
                
            }
            System.out.println();
        }
        
        
    }
}
