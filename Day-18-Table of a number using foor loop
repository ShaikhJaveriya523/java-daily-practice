Q: WAP to print tables of a number using for loop:
package for_loop;


import java.util.*;
public class For_loop {

    
    public static void main(String[] args) {
        System.out.println("Enter a number");
        Scanner sc=new Scanner(System.in);
        int no=sc.nextInt();
        for(int i=1;i<=10;i++){
            System.out.println(no*i);
        }
        
    }
    
}

