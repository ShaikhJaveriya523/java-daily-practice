Q: Implimenting Multilevel Inheritance (Method Overriding) :
Multilevel inheritance refers to a hierarchical relationship where a class inherits from another class, which itself is derived from a third class.
This creates a chain of inheritance, allowing properties and methods to propagate through multiple levels of classes.
package polymorphism_shapes;

import polymorphism_shapes.Shapes.Triangle;

class Shapes {
    public void Area(){
        System.out.println("Display Area");
    }

class Triangle extends Shapes {
    public void Area(int l,int h){
        System.out.println((1.0/2)*l*h);
    }
}
class Equilateral extends Shapes {
    public void Area(int l,int h){
        System.out.println((1.0/2)*l*h);
    }

}
}

public class Polymorphism_Shapes {

    public static void main(String[] args) {
       //Object for Triangle class
       Shapes t1=new Shapes();
       t1.Area();
       
       //Object for Triangle class
       Shapes.Triangle t2 = t1.new Triangle();
       System.out.println("Area of Triangle is:");
       t2.Area(10, 20);
       
        //Object for Triangle class
       Shapes.Equilateral t3 = t1.new Equilateral();
       System.out.println("Area of Equilateral is:");
       t3.Area(50, 70);
    }
    
}

