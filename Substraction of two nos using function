Q: WAP to calculate substraction of two nos using fuction:
package sub_fuction;

import java.util.*;
public class Sub_fuction {
    public static int SubstractNo(int a,int b){
        int sub=a-b;
        return sub;
    }

    
    public static void main(String[] args) {
        System.out.println("Enter value of a");
        Scanner sc=new Scanner(System.in);
        int a=sc.nextInt();
        System.out.println("Enter value of b");
        int b=sc.nextInt();
        
        int sub=SubstractNo(a,b);
        System.out.println("Substractions of two nos is "+ sub);
        
    }
    
}

OUTPUT:

Enter value of a
6
Enter value of b
3
