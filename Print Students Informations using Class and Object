Q: Write a program to Print Students Informations using Class and Object
package classobject_studentdetails;

class Student{
    String name;
    int roll_no;
    String standard;
    String Dept_name;
    
    public void DisplayDetails() {
        System.out.println();
        System.out.println("Student Name= " + name);   
        System.out.println("Student Roll_No= " + roll_no);
        System.out.println("Student standard = " + standard);
        System.out.println("Student Dept_name = " + Dept_name);
    }
    
    
}
public class ClassObject_StudentDetails {

    public static void main(String[] args) {
        //Creating an Object
        //for s1 Student
        Student s1=new Student();
        s1.name="Javeriya";
        s1.roll_no=63;
        s1.standard="B.Tech Third Year Engineering";
        s1.Dept_name="Computer Science Engineering";
        
        //for s2 Student
        Student s2=new Student();
        s2.name="Kanchan";
        s2.roll_no=50;
        s2.standard="B.Tech Third Year Engineering";
        s2.Dept_name="Computer Science Engineering";
        
         //for s3 Student
        Student s3=new Student();
        s3.name="Saniya";
        s3.roll_no=64;
        s3.standard="B.Tech Third Year Engineering";
        s3.Dept_name="Computer Science Engineering";
       
         //for s4 Student
        Student s4=new Student();
        s4.name="Diksha";
        s4.roll_no=45;
        s4.standard="B.Tech Third Year Engineering";
        s4.Dept_name="Computer Science Engineering";
        
        s1.DisplayDetails();
        s2.DisplayDetails();
        s3.DisplayDetails();
        s4.DisplayDetails();
        
    }
    
}

