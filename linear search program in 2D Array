Q: WAP to print linear search program in 2D Array:
package linearsearch_2darray;

import java.util.*;
public class LinearSearch_2DArray {

    
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter no of rows:");
        int rows=sc.nextInt();
        System.out.println("Enter no of cols:");
        int cols=sc.nextInt();
        
        int numbers[][]=new int[rows][cols];
        //input
        //loop for rows
        System.out.println("Enter numbers of arrays:");
        for(int i=0;i<rows;i++){
            //loop for columns
            for(int j=0;j<cols;j++ ){
                numbers[i][j]=sc.nextInt();
            }
         }
        System.out.println("Enter key element which you want to search:");
        int key=sc.nextInt();
        //loop for output
        
        for(int i=0;i<rows;i++){
           for(int j=0;j<cols;j++){
               if(numbers[i][j]==key){
                System.out.println( "The key element is found at index (" + i + "," + j + ")");
               }
            }
         
        }
        
    }
    
}

