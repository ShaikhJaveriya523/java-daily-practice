// WAP to check number is Even or Odd:

package evenodd;

import java.util.*;

public class Evenodd {
    
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int no=sc.nextInt();
        if(no%2==0){
            System.out.println("Number is even");
            
        }
        else{
             System.out.println("Number is odd");
        }
        
    }
    
}

