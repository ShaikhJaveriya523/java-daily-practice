Q:WAP to print Dimond Pyramid pattern using stars:
package dimond_pyramid;

public class Dimond_Pyramid {

    
    public static void main(String[] args) {
       int n=4;
       //upper loop
       for(int i=1;i<=n;i++){
           //Space loop
           for(int j=1;j<=n-i;j++){
               System.out.print(" ");
           }
           //Stars loop
           for(int j=1;j<=2*(i-1);j++){
               System.out.print("*");
           }
             System.out.println();
           
       }
       //lower loop
       for(int i=n;i>=1;i--){
           //Space loop
           for(int j=1;j<=n-i;j++){
               System.out.print(" ");
           }
           //Stars loop
           for(int j=1;j<=2*(i-1);j++){
               System.out.print("*");
           }
             System.out.println();
           
       }
    }
    
}

