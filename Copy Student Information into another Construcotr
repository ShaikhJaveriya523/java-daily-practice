Q: WAP to Copy Student Information into another Construcotr:
package copy_constructor;


class Student {
    String name;
    int age;
    
    public void PrintInfo() {
        System.out.println(this.name);
        System.out.println(this.age);
    }
    //Copy Constructor
    Student(Student s2) {
        this.name=s2.name;
        this.age=s2.age;
    }
    Student(){
        
    }
}
public class Copy_Constructor {

    public static void main(String[] args) {
        Student s1=new Student();
        s1.name="aman";
        System.out.println("Information of Student s1 is copied to Student s2:");
        s1.age= 24;
        
        Student s2=new Student(s1);
        System.out.println("Information of Student s2:");
        s2.PrintInfo();
    
  }
}

OUTPUT:
Information of Student s1 is copied to Student s2:
Information of Student s2:
aman
24

